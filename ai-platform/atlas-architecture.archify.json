  "cards": [
    {
      "dot": "cyan",
      "title": "三层边界",
      "items": [
        "web 只认 TraceEvent 契约与 REST 契约，不感知内核",
        "server 独占凭据、持久化与编排",
        "依赖方向靠 CI 守：import-linter 8 条契约，破了就红"
      ]
    },
    {
      "dot": "emerald",
      "title": "一轮 run 的骨架",
      "items": [
        "POST /threads/{id}/runs 立刻返回 202 {run_id}",
        "executor 在后台 asyncio.Task 里跑完整轮",
        "终态必须先落库，再发布 run.finished"
      ]
    },
    {
      "dot": "violet",
      "title": "AgentRuntime 两个实现",
      "items": [
        "NativeRuntime：本进程装配 kernel 图，直连模型网关",
        "AcpRuntime：ACP over WS 接会话 Pod 内的 bridge",
        "两者都产出 AsyncIterator[TraceEvent]，落库与锁在外层共用"
      ]
    },
    {
      "dot": "amber",
      "title": "事件回传",
      "items": [
        "TraceEvent 经 Redis Stream 出站，游标是 seq",
        "断线重连自动补发缺口，刷新页面可从断点续上",
        "取消是协作式的，不切断进行中的工具调用"
      ]
    }
  ]
