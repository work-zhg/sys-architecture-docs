  "cards": [
    {
      "dot": "cyan",
      "title": "部署形态",
      "items": [
        "server 与 cluster 同在 atlas-system，各自一个 Deployment",
        "会话 Pod 起在 atlas-sessions，每会话一个、闲置回收",
        "两个 namespace 是为了让「唯一持 K8s 写权限」在 RBAC 上成立"
      ]
    },
    {
      "dot": "violet",
      "title": "ACP 两段传输",
      "items": [
        "server ↔ bridge：ACP over WebSocket，不经过 cluster",
        "bridge ↔ CLI adapter：ACP over stdio（行分隔 JSON）",
        "两端共用 atlas_acp 的帧模型，理解漂移在类型层当场暴露"
      ]
    },
    {
      "dot": "emerald",
      "title": "遥测分流",
      "items": [
        "server 只往 Collector 发 OTLP，不直连任何后端",
        "Jaeger 看 APM（冷启动、NAS 抖动、WS 断连）",
        "Langfuse 看 LLM 维度，挂 profile，make up 默认不启动"
      ]
    },
    {
      "dot": "rose",
      "title": "有状态依赖与凭据",
      "items": [
        "Postgres 存业务记录，Redis 走事件 Stream、锁与取消位",
        "S3 是会话工作区；记忆走 Mem0，Qdrant 是它的向量后端",
        "Pod 的模型凭据经 Secret 注入，随 Pod 生灭"
      ]
    }
  ]
